{
  "name": "couch-potator",
  "version": "0.6.1",
  "description": "A folder-backed spec board with planner and unblock skills, read-only browser viewer, dependency graph, and milestones.",
  "keywords": [
    "board",
    "kanban",
    "specs",
    "planner",
    "trello",
    "cli",
    "agents"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "couch-potator": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-assets.mjs",
    "dev": "npm run build && node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack:smoke": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dompurify": "^3.2.6",
    "esbuild": "^0.28.2",
    "marked": "^16.0.0",
    "typescript": "^5.9.0"
  }
}
